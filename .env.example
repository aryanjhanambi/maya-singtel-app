# Copy to .env and fill in. .env is ignored by git and never logged.

# Required. Project API key with api.agents.read, api.agents.write and api.responses.write.
OPENAI_API_KEY=

# Optional. This evaluation branch defaults to GPT-6.1 Sol.
# OPENAI_AGENT_MODEL=gpt-6.1-sol

# Optional. GPT-6.1 Sol tool use requires at least low reasoning.
# OPENAI_REASONING_EFFORT=low

# Required for a public deployment. Use a unique generated secret of at least
# 16 characters; do not reuse the development password.
# PUBLIC_HOST=maya.example.com
# MAYA_ACCESS_PASSWORD=

# Security and capacity limits. Defaults are suitable for the initial pilot.
# MAYA_MAX_SESSIONS=6
# MAYA_SESSION_IDLE_MS=1800000
# MAYA_SESSION_MAX_AGE_MS=7200000
# MAYA_AUTH_SESSION_TTL_MS=43200000
# MAYA_AUTH_MAX_FAILURES=5
# MAYA_AUTH_FAILURE_WINDOW_MS=900000
# MAYA_AUTH_LOCKOUT_MS=900000
# MAYA_MAX_MESSAGES_PER_MINUTE=30
# MAYA_MAX_INPUT_REQUESTS_PER_MINUTE=1800

# Code release is LOCKED unless this is exactly "enabled".
# Leave it unset for every rehearsal. Set it only for the one recorded take:
# the CAST test code is single use.
# CODE_RELEASE=enabled

# Optional. The app listens on 127.0.0.1 only.
# PORT=4310

# The hosted, code-free simulation is Maya's default flow. Set this to false only
# for an intentional live CAST test, then provide the two live URLs below.
# MAYA_DEMO_MODE=false

# Optional. Where Maya starts, and where the redemption journey is expected to lead.
# In demo mode these default to the hosted GitHub Pages demo.
# START_URL=https://www.singtel.com/personal/products-services/lifestyle-services/ai-pass
# EXPECTED_REDEEM_URL=https://cast.singtel.com/order/login?redirectIntent=voucherRedemption

# Optional. Comma-separated extra hosts Maya's tools may open, read, and click on,
# in addition to the hosts of START_URL and EXPECTED_REDEEM_URL. Use this if CAST
# signs in or redirects through another host. The presenter is not limited by it.
# ALLOWED_HOSTS=login.example.com

# Optional. The browser is Chromium run by this app with Playwright.
# Run "npm run browser:install" once to download it.
# BROWSER_HEADLESS=false     # also show the Chromium window on this machine
# BROWSER_CHANNEL=chrome     # use the installed Google Chrome instead
